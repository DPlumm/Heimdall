{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.local/contracts/heartbeat.v1.schema.json",
  "title": "Heimdall Heartbeat v1",
  "description": "Canonical Huginn -> Heimdall heartbeat payload contract for MVP ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serviceName",
    "instanceName",
    "hostName",
    "version",
    "heartbeatTimestamp",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Optional payload schema marker for forward compatibility."
    },
    "heartbeatId": {
      "type": "string",
      "format": "uuid",
      "description": "Optional client-generated idempotency key for dedupe."
    },
    "serviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "serviceType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Optional metadata. For MVP deployments this should typically be 'Production'."
    },
    "instanceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "hostName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "heartbeatTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Healthy",
        "Degraded",
        "Unhealthy"
      ]
    },
    "maintenance": {
      "type": "boolean",
      "description": "Optional status effect flag indicating planned maintenance mode."
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "stats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stat"
      },
      "maxItems": 200
    },
    "build": {
      "type": "string",
      "maxLength": 120
    }
  },
  "$defs": {
    "stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 40
        }
      }
    }
  }
}
